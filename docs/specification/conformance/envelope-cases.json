{
  "description": "End-to-end message envelope cases (wire-contracts.md section 1) run against the canonical conformance handlers (see README.md). expected.body and expected.headers use subset matching. expected.isSuccessful, when present, is checked exactly against the response envelope's isSuccessful field (wire-contracts.md section 1.2). Failure cases' expected.body is the problem document (wire-contracts.md section 1.3); expected.bodyExclude lists members that must NOT appear in the parsed body (README.md).",
  "cases": [
    {
      "name": "greet-ok",
      "request": { "topic": "conformance:greet", "headers": {}, "body": "{\"name\":\"world\"}" },
      "expected": {
        "statusCode": "ok",
        "isSuccessful": true,
        "body": { "greeting": "Hello world" },
        "headers": { "content-type": "application/json" }
      }
    },
    {
      "name": "unknown-topic-returns-not-found",
      "request": { "topic": "conformance:no-such-topic", "headers": {}, "body": "{}" },
      "expected": {
        "statusCode": "not-found",
        "isSuccessful": false,
        "body": { "type": "https://benzene.app/problems/not-found", "benzeneStatus": "not-found" },
        "bodyExclude": ["status"]
      }
    },
    {
      "name": "empty-topic-returns-validation-error",
      "request": { "topic": "", "headers": {}, "body": "{}" },
      "expected": {
        "statusCode": "validation-error",
        "isSuccessful": false,
        "body": { "type": "https://benzene.app/problems/validation-error", "benzeneStatus": "validation-error" },
        "bodyExclude": ["status"]
      }
    },
    {
      "name": "status-created",
      "request": { "topic": "conformance:status", "headers": {}, "body": "{\"status\":\"created\"}" },
      "expected": { "statusCode": "created", "isSuccessful": true, "body": { "applied": "created" } }
    },
    {
      "name": "status-accepted",
      "request": { "topic": "conformance:status", "headers": {}, "body": "{\"status\":\"accepted\"}" },
      "expected": { "statusCode": "accepted", "isSuccessful": true, "body": { "applied": "accepted" } }
    },
    {
      "name": "status-updated",
      "request": { "topic": "conformance:status", "headers": {}, "body": "{\"status\":\"updated\"}" },
      "expected": { "statusCode": "updated", "isSuccessful": true, "body": { "applied": "updated" } }
    },
    {
      "name": "status-deleted",
      "request": { "topic": "conformance:status", "headers": {}, "body": "{\"status\":\"deleted\"}" },
      "expected": { "statusCode": "deleted", "isSuccessful": true, "body": { "applied": "deleted" } }
    },
    {
      "name": "status-ignored",
      "request": { "topic": "conformance:status", "headers": {}, "body": "{\"status\":\"ignored\"}" },
      "expected": { "statusCode": "ignored", "isSuccessful": true, "body": { "applied": "ignored" } }
    },
    {
      "name": "status-bad-request",
      "request": { "topic": "conformance:status", "headers": {}, "body": "{\"status\":\"bad-request\",\"errors\":[\"first error\",\"second error\"]}" },
      "expected": {
        "statusCode": "bad-request",
        "isSuccessful": false,
        "body": {
          "type": "https://benzene.app/problems/bad-request",
          "benzeneStatus": "bad-request",
          "detail": "first error, second error",
          "errors": [ { "message": "first error" }, { "message": "second error" } ]
        },
        "bodyExclude": ["status"]
      }
    },
    {
      "name": "status-validation-error",
      "request": { "topic": "conformance:status", "headers": {}, "body": "{\"status\":\"validation-error\",\"errors\":[\"first error\",\"second error\"]}" },
