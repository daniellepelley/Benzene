  "namingCases": [
    {
      "name": "colliding-names-fail",
      "description": "Two different types with the same simple name, Item, reachable from two topics: derivation fails before any message, naming both types (contract-document §4.1 rule 4).",
      "types": {
        "orders.Item": {
          "type": "object",
          "properties": {
            "sku": {
              "type": "string"
            }
          },
          "required": [
            "sku"
          ]
        },
        "payments.Item": {
          "type": "object",
          "properties": {
            "paymentId": {
              "type": "string"
            }
          },
          "required": [
            "paymentId"
          ]
        }
      },
      "registrations": {
        "requests": [
          {
            "topic": "conformance:order-item",
            "request": "orders.Item"
          },
          {
            "topic": "conformance:payment-item",
            "request": "payments.Item"
          }
        ]
      },
      "expected": {
        "error": "component-name-collision",
        "name": "Item"
      }
    },
    {
      "name": "declared-names-resolve-a-collision",
      "description": "The same two types with declared schema names OrderItem and PaymentItem: derivation succeeds and the components carry the declared names.",
      "types": {
        "orders.Item": {
          "type": "object",
          "properties": {
            "sku": {
              "type": "string"
            }
          },
          "required": [
            "sku"
          ]
        },
        "payments.Item": {
          "type": "object",
          "properties": {
            "paymentId": {
              "type": "string"
            }
          },
          "required": [
            "paymentId"
          ]
        }
      },
      "declaredNames": {
        "orders.Item": "OrderItem",
        "payments.Item": "PaymentItem"
      },
      "registrations": {
        "requests": [
          {
            "topic": "conformance:order-item",
            "request": "orders.Item"
          },
          {
            "topic": "conformance:payment-item",
            "request": "payments.Item"
          }
        ]
      },
      "expected": {
        "componentNames": [
          "OrderItem",
          "PaymentItem"
        ]
      }
    }
  ],
