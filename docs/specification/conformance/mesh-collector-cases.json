{
  "description": "Collector behavior (mesh.md sections 4-6). Each case runs its steps in order against one fresh collector; every step is a wire envelope in and out, asserted like envelope-cases (statusCode exact; body parsed-JSON subset; arrays by exact length and per-element subset). benzene:mesh:query:* shapes here follow the reference collector and are asserted only as the observable surface for ingest/derivation rules, not as promoted contracts. A register body is a contract document (mesh.md section 2); the bodies here carry only the members each case needs, with {} schemas, which a collector accepts (section 2). The producer/consumer graph (providers/consumers on query:topic) comes from the latest registration alone -- requests for consumers, events and sends for providers; traces feed invocation stats and liveness, never graph membership (mesh.md section 4.2).",
  "cases": [
    {
      "name": "register-then-fleet-shows-a-reduced-catalog-entry",
      "steps": [
        {
          "request": { "topic": "benzene:mesh:register", "headers": {}, "body": "{\"service\":\"orders\",\"requests\":[{\"topic\":\"order:create\",\"request\":{}}]}" },
          "expected": { "statusCode": "ok", "body": { "accepted": 1 } }
        },
        {
          "request": { "topic": "benzene:mesh:query:fleet", "headers": {}, "body": "{}" },
          "expected": {
            "statusCode": "ok",
            "body": {
              "services": [
                { "service": "orders", "topics": 1, "health": "unknown", "missingFeeds": ["health", "traces"] }
              ],
              "topics": [
                { "topic": "order:create", "consumers": ["orders"], "invocations": 0 }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ingest-validation",
      "steps": [
        {
          "request": { "topic": "benzene:mesh:register", "headers": {}, "body": "{\"requests\":[]}" },
          "expected": { "statusCode": "bad-request" }
        },
        {
          "request": { "topic": "benzene:mesh:heartbeat", "headers": {}, "body": "{\"health\":{\"isHealthy\":true,\"healthChecks\":{}}}" },
          "expected": { "statusCode": "bad-request" }
        },
        {
          "request": { "topic": "benzene:mesh:traces", "headers": {}, "body": "{\"events\":[]}" },
          "expected": { "statusCode": "ok", "body": { "accepted": 0 } }
        }
      ]
    },
    {
      "name": "query-validation-and-unknowns",
      "steps": [
        {
          "request": { "topic": "benzene:mesh:query:service", "headers": {}, "body": "{}" },
          "expected": { "statusCode": "bad-request" }
        },
        {
          "request": { "topic": "benzene:mesh:query:topic", "headers": {}, "body": "{}" },
          "expected": { "statusCode": "bad-request" }
        },
        {
          "request": { "topic": "benzene:mesh:query:trace", "headers": {}, "body": "{}" },
          "expected": { "statusCode": "bad-request" }
        },
        {
          "request": { "topic": "benzene:mesh:query:service", "headers": {}, "body": "{\"service\":\"ghost\"}" },
          "expected": { "statusCode": "not-found" }
        },
        {
          "request": { "topic": "benzene:mesh:query:topic", "headers": {}, "body": "{\"topic\":\"no:such\"}" },
          "expected": { "statusCode": "not-found" }
        },
        {
          "request": { "topic": "benzene:mesh:query:trace", "headers": {}, "body": "{\"traceId\":\"feed0000feed0000\"}" },
          "expected": { "statusCode": "not-found" }
        }
      ]
    },
    {
      "name": "heartbeats-drive-health-and-hash-mismatch-is-surfaced",
      "steps": [
        {
          "request": { "topic": "benzene:mesh:register", "headers": {}, "body": "{\"service\":\"orders\",\"registrationHash\":\"sha256:aaaa\",\"requests\":[{\"topic\":\"order:create\",\"request\":{}}]}" },
          "expected": { "statusCode": "ok" }
        },
        {
          "request": { "topic": "benzene:mesh:heartbeat", "headers": {}, "body": "{\"service\":\"orders\",\"instanceId\":\"orders-1\",\"registrationHash\":\"sha256:aaaa\",\"sentAt\":\"2026-07-16T09:00:00Z\",\"health\":{\"isHealthy\":true,\"healthChecks\":{}}}" },
          "expected": { "statusCode": "ok" }
        },
        {
          "request": { "topic": "benzene:mesh:query:fleet", "headers": {}, "body": "{}" },
          "expected": { "statusCode": "ok", "body": { "services": [ { "service": "orders", "health": "healthy", "instances": 1 } ] } }
        },
        {
          "request": { "topic": "benzene:mesh:heartbeat", "headers": {}, "body": "{\"service\":\"orders\",\"instanceId\":\"orders-2\",\"registrationHash\":\"sha256:bbbb\",\"sentAt\":\"2026-07-16T09:00:05Z\",\"health\":{\"isHealthy\":false,\"healthChecks\":{}}}" },
          "expected": { "statusCode": "ok" }
        },
        {
          "request": { "topic": "benzene:mesh:query:service", "headers": {}, "body": "{\"service\":\"orders\"}" },
          "expected": {
            "statusCode": "ok",
            "body": {
              "service": "orders",
              "health": "degraded",
              "instances": [
                { "instanceId": "orders-1", "healthy": true, "hashMatches": true },
                { "instanceId": "orders-2", "healthy": false, "hashMatches": false }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "provider-consumer-graph-is-declared-not-trace-derived",
      "steps": [
        {
          "request": { "topic": "benzene:mesh:register", "headers": {}, "body": "{\"service\":\"payments\",\"requests\":[{\"topic\":\"payments:capture\",\"request\":{}}]}" },
          "expected": { "statusCode": "ok" }
        },
        {
          "request": { "topic": "benzene:mesh:register", "headers": {}, "body": "{\"service\":\"orders\",\"requests\":[{\"topic\":\"order:create\",\"request\":{}}],\"sends\":[{\"topic\":\"payments:capture\",\"request\":{}}]}" },
          "expected": { "statusCode": "ok" }
        },
        {
          "request": { "topic": "benzene:mesh:query:topic", "headers": {}, "body": "{\"topic\":\"payments:capture\"}" },
          "expected": {
            "statusCode": "ok",
            "body": {
              "topic": "payments:capture",
              "providers": ["orders"],
              "consumers": ["payments"],
              "invocations": 0
            }
          }
        }
      ]
    },
    {
      "name": "trace-parentage-feeds-stats-and-liveness-not-graph-membership",
      "steps": [
        {
          "request": { "topic": "benzene:mesh:register", "headers": {}, "body": "{\"service\":\"greeter\",\"requests\":[{\"topic\":\"greet\",\"request\":{}}]}" },
          "expected": { "statusCode": "ok" }
        },
        {
          "request": { "topic": "benzene:mesh:traces", "headers": {}, "body": "{\"events\":[{\"traceId\":\"trace0000000000000000000000000001\",\"spanId\":\"span00000000000f\",\"service\":\"frontdoor\",\"topic\":\"welcome\",\"status\":\"ok\",\"durationMs\":20,\"startedAt\":\"2026-07-16T09:00:00Z\"},{\"traceId\":\"trace0000000000000000000000000001\",\"spanId\":\"span00000000001f\",\"parentSpanId\":\"span00000000000f\",\"service\":\"greeter\",\"topic\":\"greet\",\"status\":\"ok\",\"durationMs\":10,\"startedAt\":\"2026-07-16T09:00:00.005Z\"},{\"traceId\":\"trace0000000000000000000000000002\",\"spanId\":\"span00000000002f\",\"service\":\"greeter\",\"topic\":\"greet\",\"status\":\"service-unavailable\",\"durationMs\":30,\"startedAt\":\"2026-07-16T09:00:01Z\"}]}" },
          "expected": { "statusCode": "ok", "body": { "accepted": 3 } }
        },
        {
          "request": { "topic": "benzene:mesh:query:topic", "headers": {}, "body": "{\"topic\":\"greet\"}" },
          "expected": {
            "statusCode": "ok",
            "body": {
              "topic": "greet",
              "providers": [],
              "consumers": ["greeter"],
              "invocations": 2,
              "errors": 1,
              "statusCounts": { "ok": 1, "service-unavailable": 1 }
            }
          }
        },
        {
          "request": { "topic": "benzene:mesh:query:service", "headers": {}, "body": "{\"service\":\"frontdoor\"}" },
          "expected": {
            "statusCode": "ok",
            "body": { "service": "frontdoor", "invocations": 1, "missingFeeds": ["descriptor", "health"] }
          }
        },
        {
          "request": { "topic": "benzene:mesh:query:trace", "headers": {}, "body": "{\"traceId\":\"trace0000000000000000000000000001\"}" },
          "expected": {
            "statusCode": "ok",
            "body": {
              "traceId": "trace0000000000000000000000000001",
              "events": [
                { "spanId": "span00000000000f", "service": "frontdoor" },
                { "spanId": "span00000000001f", "service": "greeter" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "reregistration-replaces-provider-and-consumer-edges",
      "steps": [
        {
          "request": { "topic": "benzene:mesh:register", "headers": {}, "body": "{\"service\":\"payments\",\"requests\":[{\"topic\":\"payments:capture\",\"request\":{}}]}" },
          "expected": { "statusCode": "ok" }
        },
        {
          "request": { "topic": "benzene:mesh:register", "headers": {}, "body": "{\"service\":\"orders\",\"requests\":[{\"topic\":\"order:create\",\"request\":{}}],\"sends\":[{\"topic\":\"payments:capture\",\"request\":{}}]}" },
          "expected": { "statusCode": "ok" }
        },
        {
          "request": { "topic": "benzene:mesh:register", "headers": {}, "body": "{\"service\":\"orders\",\"requests\":[{\"topic\":\"order:cancel\",\"request\":{}}]}" },
          "expected": { "statusCode": "ok" }
        },
        {
          "request": { "topic": "benzene:mesh:query:topic", "headers": {}, "body": "{\"topic\":\"order:create\"}" },
          "expected": { "statusCode": "ok", "body": { "topic": "order:create", "consumers": [] } }
        },
        {
          "request": { "topic": "benzene:mesh:query:topic", "headers": {}, "body": "{\"topic\":\"payments:capture\"}" },
          "expected": { "statusCode": "ok", "body": { "topic": "payments:capture", "providers": [], "consumers": ["payments"] } }
        }
      ]
    },
    {
      "name": "a-published-event-makes-its-publisher-a-provider",
      "steps": [
        {
          "request": {
            "topic": "benzene:mesh:register",
            "headers": {},
            "body": "{\"service\":\"orders\",\"requests\":[{\"topic\":\"order:create\",\"request\":{}}],\"events\":[{\"topic\":\"order:placed\",\"message\":{}}]}"
          },
          "expected": {
            "statusCode": "ok"
          }
        },
        {
          "request": {
            "topic": "benzene:mesh:register",
            "headers": {},
            "body": "{\"service\":\"shipping\",\"requests\":[{\"topic\":\"order:placed\",\"request\":{}}]}"
          },
          "expected": {
            "statusCode": "ok"
          }
        },
        {
          "request": {
            "topic": "benzene:mesh:query:topic",
            "headers": {},
            "body": "{\"topic\":\"order:placed\"}"
          },
          "expected": {
            "statusCode": "ok",
            "body": {
              "topic": "order:placed",
              "providers": [
                "orders"
              ],
              "consumers": [
                "shipping"
              ],
              "invocations": 0
            }
          }
        }
      ]
    },
    {
      "name": "benzene-entries-in-a-registration-are-ignored",
      "steps": [
        {
          "request": {
            "topic": "benzene:mesh:register",
            "headers": {},
            "body": "{\"service\":\"orders\",\"requests\":[{\"topic\":\"order:create\",\"request\":{}},{\"topic\":\"benzene:spec\",\"request\":{}}],\"sends\":[{\"topic\":\"benzene:mesh:traces\",\"request\":{}}]}"
          },
          "expected": {
            "statusCode": "ok"
          }
        },
        {
          "request": {
            "topic": "benzene:mesh:query:fleet",
            "headers": {},
            "body": "{}"
          },
          "expected": {
            "statusCode": "ok",
            "body": {
              "services": [
                {
                  "service": "orders",
                  "topics": 1
                }
              ],
              "topics": [
                {
                  "topic": "order:create",
                  "consumers": [
                    "orders"
                  ]
                }
              ]
            }
          }
        },
        {
          "request": {
            "topic": "benzene:mesh:query:topic",
            "headers": {},
            "body": "{\"topic\":\"benzene:spec\"}"
          },
          "expected": {
            "statusCode": "not-found"
          }
        },
        {
          "request": {
            "topic": "benzene:mesh:query:topic",
            "headers": {},
            "body": "{\"topic\":\"benzene:mesh:traces\"}"
          },
          "expected": {
            "statusCode": "not-found"
          }
        }
      ]
    },
    {
      "name": "a-registration-carrying-only-service-is-accepted",
      "steps": [
        {
          "request": {
            "topic": "benzene:mesh:register",
            "headers": {},
            "body": "{\"service\":\"orders\"}"
          },
          "expected": {
            "statusCode": "ok",
            "body": {
              "accepted": 1
            }
          }
        },
        {
          "request": {
            "topic": "benzene:mesh:query:fleet",
            "headers": {},
            "body": "{}"
          },
          "expected": {
            "statusCode": "ok",
            "body": {
              "services": [
                {
                  "service": "orders"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
