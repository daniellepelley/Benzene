{
  "schemaDialect": "openapi-3.0",
  "service": "orders-api",
  "serviceVersion": "2.4.0",
  "versionScheme": "semver",
  "description": "Accepts and tracks customer orders through to fulfilment.",
  "messageEndpoint": "/benzene/invoke",
  "transports": [
    "http",
    "sqs"
  ],
  "contractHash": "sha256:770f508339e7cdec6edac0f7ab851936a6e31e2e82baa75bdc094e68ac7eeb34",
  "registrationHash": "sha256:071bee40c16eddae22868c606e9f768d2b54a22961e6d1074e66ba198031e0bf",
  "requests": [
    {
      "topic": "orders:create",
      "version": "v1",
      "httpMappings": [
        {
          "method": "POST",
          "path": "/orders"
        }
      ],
      "request": {
        "$ref": "#/components/schemas/CreateOrder"
      },
      "response": {
        "$ref": "#/components/schemas/OrderCreated"
      },
      "example": {
        "customerId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
        "lines": [
          {
            "sku": "SKU-1",
            "quantity": 2
          }
        ]
      }
    },
    {
      "topic": "orders:get-all",
      "httpMappings": [
        {
          "method": "GET",
          "path": "/orders"
        }
      ],
      "request": {
        "type": "object"
      },
      "response": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/OrderDto"
        }
      }
    },
    {
      "topic": "orders:cancel",
      "request": {
        "$ref": "#/components/schemas/CancelOrder"
      }
    }
  ],
  "events": [
    {
      "topic": "order:placed",
      "message": {
        "$ref": "#/components/schemas/OrderPlaced"
      }
    },
    {
      "topic": "order:legacy-export",
      "message": {
        "$ref": "#/components/schemas/LegacyOrderExport"
      }
    }
  ],
  "sends": [
    {
      "topic": "payment:capture",
      "version": "v2",
      "request": {
        "$ref": "#/components/schemas/PaymentCapture"
      }
    },
    {
      "topic": "stock:reserve",
      "request": {
        "$ref": "#/components/schemas/ReserveStock"
      },
      "response": {
        "$ref": "#/components/schemas/StockReservation"
      }
    }
  ],
  "components": {
    "schemas": {
      "Address": {
        "type": "object",
        "properties": {
          "line1": {
            "type": "string"
          },
          "postcode": {
            "type": "string"
          }
        },
        "required": [
          "line1",
          "postcode"
        ]
      },
      "CancelOrder": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "orderId"
        ]
      },
      "CreateOrder": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            }
          },
          "shippingAddress": {
            "type": "object",
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Address"
              }
            ]
          }
        },
        "required": [
          "customerId",
          "lines"
        ]
      },
      "LegacyOrderExport": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          }
        },
        "required": [
          "orderId"
        ]
      },
      "OrderCreated": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "rejected"
            ]
          }
        },
        "required": [
          "orderId",
          "status"
        ]
      },
      "OrderDto": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "placedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "orderId",
          "placedAt"
        ]
      },
      "OrderLine": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          }
        },
        "required": [
          "sku",
          "quantity"
        ]
      },
      "OrderPlaced": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "orderId",
          "customerId"
        ]
      },
      "PaymentCapture": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          }
        },
        "required": [
          "orderId",
          "amount"
        ]
      },
      "ReserveStock": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "sku",
          "quantity"
        ]
      },
      "StockReservation": {
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string"
          }
        },
        "required": [
          "reservationId"
        ]
      }
    }
  }
}
